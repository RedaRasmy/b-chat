{
    "extends": "@bchat/ts-config/base.json",
    "compilerOptions": {
        "resolveJsonModule": true,
        "types": ["node", "vitest/globals"],
        "paths": {
            "@/*": ["./src/*"]
        },
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
