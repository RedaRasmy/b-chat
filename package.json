{
    "name": "bchat",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "start": "pnpm --filter @bchat/server start",
        "format": "prettier --write \"**/*.{ts,tsx,md,json,js,mjs,yaml,yml}\"",
        "test": "turbo test --filter=!@bchat/playwright",
        "ete:install-deps": "pnpm --filter @bchat/playwright install-deps",
        "ete": "pnpm --filter @bchat/playwright test",
        "lint": "turbo lint",
        "db:push": "pnpm --filter=@bchat/database push",
        "db:generate": "pnpm --filter=@bchat/database generate",
        "db:migrate": "pnpm --filter=@bchat/database migrate",
        "db:studio": "pnpm --filter=@bchat/database studio",
        "db:seed": "pnpm --filter=@bchat/database seed",
        "act:playwright": "act -W .github/workflows/playwright.yml push",
        "act:lint": "act -W .github/workflows/lint.yml push",
        "act:test": "act -W .github/workflows/test.yml push"
    },
    "devDependencies": {
        "prettier": "^3.9.6",
        "turbo": "^2.10.12"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.9.0"
        }
    }
}
